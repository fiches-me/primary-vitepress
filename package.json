{
  "name": "primary-vitepress",
  "version": "1.1.3",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./plugins/mermaid": {
      "types": "./dist/plugins/vitepress-mermaid/index.d.ts",
      "import": "./dist/plugins/vitepress-mermaid/index.js"
    },
    "./plugins/task-checkbox": {
      "types": "./dist/plugins/markdown-it-task-checkbox.d.ts",
      "import": "./dist/plugins/markdown-it-task-checkbox.js"
    },
    "./style": "./layout.css"
  },
  "files": [
    "dist",
    "*.css",
    "css",
    "plugins/**/*.vue",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc --noEmit"
  }
}
